# =============================================================================
# Caddyfile - Proxy Reverso com HTTPS Automático (Let's Encrypt)
# =============================================================================
# Substitua "api.seudominio.com" pelo subdomínio real da sua API.
# O Caddy gera e renova certificados HTTPS automaticamente.
#
# SEGURANÇA:
#   - Rate limiting é gerenciado pela camada Python (slowapi)
#   - Autenticação é gerenciada pela camada Python (API Key)
#   - O Caddy atua apenas como proxy reverso + TLS termination
# =============================================================================

api.seudominio.com {
    reverse_proxy api:8000
}
