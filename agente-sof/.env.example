APP_NAME="Agente SOF - API IoT & RAG"
APP_VERSION="0.1.0"
APP_ENV="development"
API_KEY="dev-api-key-insegura"
SECRET_KEY="chave-insegura-apenas-para-desenvolvimento"
ADMIN_API_KEY="dev-admin-key-insegura-para-teste"
