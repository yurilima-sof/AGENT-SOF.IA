POSTGRES_USER=agente_user
POSTGRES_PASSWORD=agente_senha_dev
POSTGRES_DB=agente_sof_db
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
TUYA_CLIENT_ID=""
TUYA_CLIENT_SECRET=""
TUYA_BASE_URL="https://openapi.tuyaus.com"
