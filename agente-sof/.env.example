# =============================================================================
# Configuração de Ambiente — Agente SOF (SOF.IA)
# =============================================================================
# Copie este arquivo para .env em ambiente de desenvolvimento local:
# cp .env.example .env
# =============================================================================

# Aplicação
APP_NAME="Agente SOF — API IoT & RAG"
APP_VERSION="0.1.0"
APP_ENV="development"

# Segurança e Autenticação
# Em produção (APP_ENV=production), API_KEY e SECRET_KEY devem ter no mínimo 32 caracteres.
API_KEY="dev-api-key-insegura"
SECRET_KEY="chave-insegura-apenas-para-desenvolvimento"

# Banco de Dados PostgreSQL (com pgvector)
DATABASE_URL="postgresql+asyncpg://agente_user:agente_pass@localhost:5432/agente_sof_db"

# Inteligência Artificial — Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Integração Tuya Cloud OpenAPI (Fase 2)
TUYA_CLIENT_ID=""
TUYA_CLIENT_SECRET=""
TUYA_BASE_URL="https://openapi.tuyaus.com"
