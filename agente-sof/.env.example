# =============================================================================
# .env.example - Exemplo de Variáveis de Ambiente
# =============================================================================
# INSTRUÇÕES PARA O DESENVOLVEDOR:
#  1. Copie este arquivo: cp .env.example .env
#  2. Preencha os valores no arquivo .env com suas credenciais reais.
#  3. NUNCA faça commit do arquivo .env no Git! (já está no .gitignore)
#
# O arquivo .env é lido automaticamente pela nossa aplicação via python-dotenv.
# =============================================================================


# --- Configurações do PostgreSQL ---
# Devem ser os MESMOS valores usados no docker-compose.yml
POSTGRES_USER=agente_user
POSTGRES_DB=agente_sof_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ⚠️ PRODUÇÃO: Use uma senha forte! Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# URL de conexão completa (usada pelo SQLAlchemy/asyncpg)
# Formato: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
# ⚠️ Em Docker Compose, o HOST é "db" (nome do serviço), não "localhost"
DATABASE_URL=postgresql+asyncpg://agente_user:troque_por_uma_senha_forte@localhost:5432/agente_sof_db

# --- Configurações da API ---
# Ambiente de execução: development | staging | production
APP_ENV=development

# Porta onde o Uvicorn vai escutar
APP_PORT=8000

# --- Segurança ---
# Chave secreta para geração de tokens JWT (se precisarmos no futuro)
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere_uma_chave_secreta_forte_aqui

# Chave de autenticação da API (obrigatória).
# O n8n DEVE enviar no header: Authorization: Bearer <API_KEY>
# ⚠️ PRODUÇÃO: Gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=gere_uma_api_key_forte_aqui

# --- Configurações do Google Gemini ---
GEMINI_API_KEY=sua_chave_gemini_aqui
