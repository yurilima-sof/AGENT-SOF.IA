      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const webhookBody = $('Webhook').first().json.body || {};\n\n  const agoraBrasilia = $now.setZone('America/Sao_Paulo');\n\n  const mensagem = webhookBody.text?.message || webhookBody.message || \"\";\n  const solicitadoPor = webhookBody.senderName || \"Desconhecido\";\n  const numero = webhookBody.connectedPhone || webhookBody.phone || \"N/A\";\n  const grupo = webhookBody.chatName || \"Chat Individual\";\n\n  return {\n    json: {\n      \"Data\": agoraBrasilia.toFormat('dd/MM/yyyy'),\n      \"Hora\": agoraBrasilia.toFormat('HH:mm:ss'),\n      \"Solicitado através\": grupo,\n      \"Atuação\": \"Atendimento via Bot\",\n      \"Solicitado por\": `${solicitadoPor} (${numero})`,\n      \"mensagem\": mensagem\n    }\n  };\n});"
      },
